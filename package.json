{
  "name": "auto-cc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop job-hunting copilot for the Chinese market",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && tsx scripts/check-renderer-conventions.ts && tsx scripts/check-knowledge-pack.ts && tsx scripts/check-llm-single-entry.ts && tsx scripts/check-compliance-redlines.ts && tsx scripts/check-dependency-floor.ts && tsx scripts/check-prompts.ts && tsx scripts/check-agent-model-authority.ts && tsx scripts/check-tool-contract.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harness": "pnpm --filter @auto-cc/testing harness",
    "status:check": "tsx scripts/check-status.ts",
    "bench:kb": "pnpm --filter @auto-cc/plugin-resume-kb bench",
    "app:build": "tsx scripts/build.ts",
    "dist": "pnpm app:build && electron-builder --config electron-builder.yml --dir --publish never",
    "dist:win": "pnpm app:build && electron-builder --config electron-builder.yml --win --publish never",
    "dist:mac": "pnpm app:build && electron-builder --config electron-builder.yml --mac --publish never",
    "dist:linux": "pnpm app:build && electron-builder --config electron-builder.yml --linux --publish never",
    "postinstall": "node packages/main/node_modules/electron/install.js",
    "prepare": "git config core.hooksPath .githooks",
    "fixture": "tsx scripts/fixture-server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
