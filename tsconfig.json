{
  "extends": "./tsconfig.base.json",
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "scripts/**/*", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "packages/renderer"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  }
}
